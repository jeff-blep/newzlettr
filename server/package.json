{
  "name": "@newzlettr/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEWZLETTR_CONFIG_DIR=../config tsx watch --clear-screen=false src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "croner": "^9.1.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.12.0",
    "nodemailer": "^10.3.1",
    "pino": "^9.14.0",
    "sanitize-html": "^2.18.1",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15"
  }
}
